{
  "name": "tech-deep-dives",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive technical deep-dives powered by Cloudscape",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter './deep-dives/*' run dev",
    "build": "pnpm --filter './deep-dives/*' run build",
    "lint": "pnpm --filter './deep-dives/*' run lint && pnpm --filter @tech-deep-dives/shared run lint",
    "typecheck": "pnpm --filter './deep-dives/*' run typecheck && pnpm --filter @tech-deep-dives/shared run typecheck",
    "test": "pnpm --filter './deep-dives/*' run test",
    "gates": "bash scripts/ci.sh",
    "audit": "bash scripts/audit.sh",
    "audit:playwright": "bash scripts/audit.sh --with-playwright",
    "audit:agents": "bash scripts/audit.sh --with-agents",
    "audit:all": "bash scripts/audit.sh --with-playwright --with-citations --with-agents",
    "audit:citations": "bash scripts/audit.sh --with-citations"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "html-validate": "^10.13.1"
  }
}
